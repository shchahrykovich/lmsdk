{
  "name": "lmsdk",
  "private": true,
  "version": "0.1.21",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint-with-warnings": "eslint",
    "lint": "eslint . --quiet --max-warnings=0",
    "preview": "npm run build && vite preview",
    "db:version": "wrangler d1 time-travel info DB",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:version && npm run db:migrations:apply && npm run build && wrangler deploy",
    "deploy-from-local": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ai": "vitest run --teardown-timeout=2500 --reporter=./tests/vitest-ai-reporter.ts",
    "test:large": "LMSDK_LARGE_TESTS=1 vitest run --teardown-timeout=2500 --reporter=./tests/vitest-ai-reporter.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
